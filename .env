# 動態資金控管設定
TOTAL_CAPITAL=1000000  # 您打算投入的總本金 (決定每筆下單量)
# ============================================================
# 風險控制參數
# ============================================================
# 這些參數控制交易風險，建議保持保守設定

# 最大單日虧損比例 (例如: 0.03 = 3%)
MAX_DAILY_LOSS=0.03

# 最大單筆倉位比例 (例如: 0.05 = 5%)
MAX_POSITION_SIZE=0.05

# 最大單日交易次數
MAX_DAILY_TRADES=20

# 連續虧損上限（觸發後暫停交易）
MAX_LOSS_STREAK=3

# 單一標的當日最大虧損次數（觸發後加入黑名單）
MAX_LOSS_PER_SYMBOL=2

POSITION_SIZING_MODE=kelly
# ============================================================
# 系統設定
# ============================================================
# 資料庫檔案路徑
DB_PATH=trading_data.db

# 日誌等級 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 起始資金（用於風控計算）
INITIAL_CAPITAL=1000000

# ============================================================
# 監控清單（逗號分隔，不要有空格）
# ============================================================
# 這個清單會被 daily_stock_screening.py 的結果覆蓋
# 但可以作為備援清單

WATCHLIST=2330,2454,2317,2303,2382,6669,3231,1519

# ============================================================
# 選股參數（可選）
# ============================================================
# 這些參數可以覆蓋 daily_stock_screening.py 的預設值

# 最小振幅 (%)
MIN_AMPLITUDE=2.0

# 最小周轉率 (%)
MIN_TURNOVER=3.0

# 最終挑選數量
FINAL_PICKS=15

# ============================================================
# 進階設定（通常不需要修改）
# ============================================================
# 交易時間
TRADING_START=09:00
TRADING_END=13:25

# 系統資源告警閾值
MAX_CPU_PERCENT=80
MAX_MEMORY_PERCENT=80
MAX_DISK_PERCENT=90

# 錯誤計數告警閾值
MAX_ERROR_COUNT=10

# ============================================================
# 快速測試
# ============================================================
TRADE_MODE=PAPER
TOTAL_CAPITAL=1000000
RISK_PCT=0.02
MAX_DAILY_LOSS=-20000
