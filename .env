# ============================================================
# 風險控制參數
# ============================================================
# MAX_DAILY_LOSS: 每日最大虧損絕對金額（負數），觸發全局熔斷
MAX_DAILY_LOSS=-20000

# RISK_PCT: 每筆交易最大風險比例（fixed_risk 模式使用）
