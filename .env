# POSITION_SIZING_MODE: fixed_risk / capital_pct / kelly
POSITION_SIZING_MODE=kelly

# MAX_HOLDING_SECONDS: 最長持倉秒數（時間停損）
MAX_HOLDING_SECONDS=1800

# 最大單日交易次數
MAX_DAILY_TRADES=20

# 連續虧損上限（觸發後暫停交易）
